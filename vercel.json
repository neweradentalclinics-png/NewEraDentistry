{
  "rewrites": [
    {
      "source": "/:f(google[a-z0-9]+\\.html)",
      "destination": "/api/seo?gverify=:f"
    },
    {
      "source": "/blog",
      "destination": "/api/seo?blog=index"
    },
    {
      "source": "/blog/:post([a-z0-9][a-z0-9-]*)",
      "destination": "/api/seo?blog=:post"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?sitemap=1"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*)",
      "destination": "/api/seo?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
